# 用法:先复制为 .env 再填值(docker compose 在 open-design 目录下自动读取)
#   cp .env.example .env
# 免密模式(仅绑本机 127.0.0.1,局域网不可达)。不推荐,但够用。
OPEN_DESIGN_DISABLE_API_AUTH=1

# 若改回 token 认证:把上面置空,并用 openssl rand -hex 32 生成后填这里
OD_API_TOKEN=

# 监听端口(daemon + Web 同一端口)
OPEN_DESIGN_PORT=7456

# 升级时改 tag 后: docker compose pull && docker compose up -d
OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:0.21.1

# 容器内存上限
OPEN_DESIGN_MEM_LIMIT=384m
